# 11 October 2026 : fast creation of measured geometry in a stash SOP (bulk points, bulk attributes, bulk polygons)
# FR : création rapide de la géométrie mesurée dans un stash (points, attributs et polygones en bloc).
import hou


def stash_polys(parent_path, name, polys, value_key="val", closed=True, rgb=False):
    """polys: list of dicts with 'pts' [(x, y)], optional 'z', and value_key (float) or 'rgb' (3 floats)."""
    parent = hou.node(parent_path) or hou.node("/obj").createNode("geo", parent_path.split("/")[-1])
    parent.setDisplayFlag(False)
    st = parent.node(name) or parent.createNode("stash", name)
    geo = hou.Geometry()
    geo.addAttrib(hou.attribType.Point, "Cd", (0.0, 0.0, 0.0))
    positions = []
    colors = []
    counts = []
    for p in polys:
        z = float(p.get("z", 0.0))
        pts = p["pts"]
        if rgb:
            c = [float(v) for v in p["rgb"]]
        else:
            v = float(p.get(value_key, 1.0))
            c = [v, v, v]
        for x, y in pts:
            positions.append(hou.Vector3(x, y, z))
            colors.extend(c)
        counts.append(len(pts))
    geo.createPoints(positions)
    geo.setPointFloatAttribValues("Cd", colors)
    # polygons: consecutive point ranges, given as point numbers (11 October 2026 : is_closed is positional only in H22)
    idx = 0
    prim_points = []
    for n in counts:
        prim_points.append(tuple(range(idx, idx + n)))
        idx += n
    geo.createPolygons(tuple(prim_points), closed)
    st.parm("stash").set(geo)
    return st
