# 11 October 2026 : base colour comparison: CIE Lab Delta E 76, luminance correlation and SSIM, per channel MAE, panel
# FR : comparaison de base color : Delta E 76 en Lab, corrélation et SSIM de luminance, erreur par canal, planche.
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
from PIL import Image
from RefLib import load_rgb, load_gray, blur
import Measure as M


def srgb_to_lab(rgb):
    a = np.where(rgb <= 0.04045, rgb / 12.92, ((rgb + 0.055) / 1.055) ** 2.4)
    Mx = np.array([[0.4124, 0.3576, 0.1805], [0.2126, 0.7152, 0.0722], [0.0193, 0.1192, 0.9505]])
    xyz = a @ Mx.T
    xyz /= np.array([0.95047, 1.0, 1.08883])
    f = np.where(xyz > 0.008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
    L = 116 * f[..., 1] - 16
    A = 500 * (f[..., 0] - f[..., 1])
    B = 200 * (f[..., 1] - f[..., 2])
    return np.stack([L, A, B], -1)


def measure_color(cand, ref, valid):
    lc, lr = srgb_to_lab(cand), srgb_to_lab(ref)
    de = np.sqrt(((lc - lr) ** 2).sum(-1))
    yc, yr = cand.mean(-1), ref.mean(-1)
    out = {"deltaE76_mean": float(de[valid].mean()), "deltaE76_p90": float(np.quantile(de[valid], 0.9)),
           "lum_pearson": M.pearson(yc, yr, valid), "lum_ssim": M.ssim(yc, yr, valid, 1.5),
           "mae_rgb": [float(np.abs(cand[..., c] - ref[..., c])[valid].mean()) for c in range(3)],
           "deltaE76_blur4_mean": float(np.sqrt(((srgb_to_lab(np.stack([blur(cand[..., c], 4) for c in range(3)], -1)) - srgb_to_lab(np.stack([blur(ref[..., c], 4) for c in range(3)], -1))) ** 2).sum(-1))[valid].mean())}
    return out


def panel(cand, ref, path, zoom=(100, 612, 100, 612)):
    z = lambda a: a[zoom[0]:zoom[1], zoom[2]:zoom[3]]
    small = lambda a: np.asarray(Image.fromarray((np.clip(a, 0, 1) * 255).astype(np.uint8)).resize((512, 512), Image.LANCZOS)).astype(np.float32) / 255
    img = np.concatenate([small(ref), small(cand), z(ref), z(cand)], 1)
    Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8)).save(path)


if __name__ == "__main__":
    c = load_rgb(sys.argv[1])
    r = load_rgb(sys.argv[2])
    v = load_gray(sys.argv[3]) > 0.5
    m = measure_color(c, r, v)
    print(json.dumps(m))
    if len(sys.argv) > 4:
        json.dump(m, open(sys.argv[4], "w"), indent=1)
        panel(c, r, sys.argv[4].replace(".json", "_panel.png"))
