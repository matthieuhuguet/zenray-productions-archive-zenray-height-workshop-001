    f=$W/render/uv_mode${mode}_${view}.png; rm -f $f
    python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom "g = {}
exec(open('/Users/zenray/.claude/skills/zenray-houdini/scripts/height/LookDevMaps.py').read(), g)
result = g['build']('$W/maps_checker', 'T_UvChecker', '$f', shape='cylinder', cyl_uv=$mode, disp_scale=0.0, cam_focal=35.0, samples=12, $CAM)" live | tail -1
    until stable $f; do sleep 5; done
    echo "mode $mode $view $(date '+%H:%M:%S')"
  done
done
