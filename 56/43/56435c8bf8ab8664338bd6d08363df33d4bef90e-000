tmp/tmp-zenray-height/dataset/parts/05_substance_designer_nodes.md'\nCOPLIST = '/Users/zenray/.claude/tmp/tmp-zenray-height/dataset/cop_nodes_h22.txt'\nDATE = '11 October 2026'\nEL_BASE = 'https://experienceleague.adobe.com/en/docs/substance-3d-designer/using/substance-graphs/nodes-reference-for-substance-graphs/'\nHX_MARK = 'nodes-reference-for-substance-compositing-graphs/'\n\nnodes = json.load(open(os.path.join(WORK, 'nodes.json')))\ncopidx = json.load(open(os.path.join(WORK, 'cop_params.json')))\ncopnames = set()\nfor ln in open(COPLIST, encoding='utf-8'):\n    if ln.startswith('#') or '|' not in ln:\n        continue\n    copnames.add(ln.split('|')[0].strip())\n\nerrors, warnings = [], []\n\ndef d(s):\n    \"\"\"append the date to a line if missing\"\"\"\n    return s if DATE in s else s + ' (' + DATE + ')'\n\ndef fix_range(r):\n    r = re.sub(r'\\s+-\\s+', ' to ', r)\n    r = r.replace('–', '-').replace('—', '-')\n    r = re.sub(r'\\s*\\[(static|primary)[^\\]]*\\]', lambda m: ' [' + m.group(1) + ']', r)\n    return r.strip()\n\ndef el_url(n):\n    h = n.get('helpx_url', '')\n    if HX_MARK in h:\n        tail = h.split(HX_MARK, 1)[1]\n        tail = re.sub(r'\\.html$', '', tail)\n        return EL_BASE + tail\n    return h\n\ndef find_page(src):\n    c = [n for n in nodes if src in n['file']]\n    if len(c) == 1:\n        return c[0]\n    exact = [n for n in c if n['file'].endswith(src.rstrip('/') + '.md') or ('/' + src.rstrip('/') + '/') in ('/' + n['file'])]\n    if len(exact) == 1:\n        return exact[0]\n    return c if c else None\n\ndef parse_entries():\n    entries = []\n    for f in sorted(glob.glob(os.path.join(WORK, 'entries', '*.txt'))):\n        cur = None\n        for i, raw in enumerate(open(f, encoding='utf-8'), 1):\n            line = raw.rstrip('\\n')\n            if not line.strip() or line.lstrip().startswith('#!'):\n                continue\n            if line.startswith('## '):\n                cur = {'id': line[3:].strip(), 'k': [], 'kx': [], 'file': os.path.basename(f), 'line': i}\n                entries.append(cur)\n                continue\n            m = re.match(r'^([a-z]+):\\s?(.*)$', line)\n            if not m or cur is None:\n                errors.append('%s:%d cannot parse: %s' % (os.path.basename(f), i, line[:80]))\n                continue\n            key, val = m.group(1), m.group(2).strip()\n            if key == 'k':\n                p = [x.strip() for x in val.split(' | ', 1)]\n                if len(p) != 2:\n                    errors.append('%s:%d bad k line' % (os.path.basename(f), i))\n                else:\n                    cur['k'].append(p)\n            elif key == 'kx':\n                p = [x.strip() for x in val.split(' | ', 2)]\n                if len(p) != 3:\n                    errors.append('%s:%d bad kx line' % (os.path.basename(f), i))\n                else:\n                    cur['kx'].append(p)\n            else:\n                cur[key] = val\n    return entries\n\ndef render_cop(text, entry_id):\n    used = []\n    def nrep(m):\n        nm = m.group(1)\n        used.append(nm)\n        if nm not in copnames:\n            errors.append('[%s] unknown COP node @%s' % (entry_id, nm))\n        return '`' + nm + '`'\n    out = re.sub(r'@([a-z0-9_]+)', nrep, text)\n    labels_ok = set()\n    for u in used:\n        info = copidx.get(u)\n        if info:\n            labels_ok.update(info['params'])\n            for k, v in info['options'].items():\n                labels_ok.update(v)\n    def lrep(m):\n        lab = m.group(1)\n        if lab not in labels_ok:\n            warnings.append('[%s] label {%s} not found in help of %s' % (entry_id, lab, ','.join(sorted(set(used))) or 'no node'))\n        return '**' + lab + '**'\n    out = re.sub(r'\\{([^{}]+)\\}', lrep, out)\n    return out\n\nSTATUS = {\n    'sidefx': 'SideFX-confirmed at node level (the SideFX Copernicus for Substance 3D Designer users page lists this correspondence), parameter setup read from the local Houdini 22.0.368 node help',\n    'unverified': 'UNVERIFIED (mapping and parameter values inferred by me; COP node names checked against the Houdini 22.0.368 node list, parameter labels read in the local node help)',\n}\n\ndef render_entry(e, page):\n    L = []\n    name = e.get('name') or (page['title'] if page else e['id'])\n    L.append('### ' + name)\n    L.append('- Category: ' + e.get('cat', '?'))\n    if e.get('rel'):\n        L.append('- Height relevance: ' + e['rel'])\n    if page:\n        L.append('- Source: ' + el_url(page))\n    elif e.get('url'):\n        L.append('- Source: ' + e['url'])\n    L.append('- Purpose: ' + e['purpose'])\n    if e.get('note'):\n        L.append('- Note: ' + e['note'])\n    if page and page['inputs']:\n        L.append('- Inputs: ' + '; '.join('%s (%s)' % (i['name'], fix_range(i['type'])) if i['type'] else i['name'] for i in page['inputs']))\n    pars = page['parameters'] if page else []\n    keyed = set()\n    if e['k'] or e['kx']:\n        L.append('- Key parameters:')\n        for nm, desc in e['k']:\n            cands = [p for p in pars if p['name'].strip().lower() == nm.strip().lower()]\n            if not cands:\n                errors.append('[%s] parameter \"%s\" not on page %s (have: %s)' % (e['id'], nm, page['file'] if page else None, ', '.join(dict.fromkeys(p['name'] for p in pars))[:300]))\n                continue\n            p = next((c for c in cands if c['desc']), cands[0])\n            keyed.add(nm.strip().lower())\n            rng = fix_range(p['range'])\n            L.append('  - `%s`%s: %s' % (p['name'], ' (' + rng + ')' if rng else '', desc))\n        for nm, rng, desc in e['kx']:\n            L.append('  - `%s`%s: %s' % (nm, ' (' + rng + ')' if rng else '', desc))\n    if pars and e.get('skipparams') != 'yes':\n        others = []\n        seen = set()\n        for p in pars:\n            k = p['name'].strip().lower()\n            if k in keyed or k in seen:\n                continue\n      