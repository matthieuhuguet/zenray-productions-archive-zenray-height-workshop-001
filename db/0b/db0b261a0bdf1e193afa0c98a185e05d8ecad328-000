# 11 October 2026 : build the COP node reference part of Copernicus2.md from the local Houdini 22.0.368 help and the live node types
# FR : construit la partie « référence des nœuds COP » de Copernicus2.md depuis l'aide locale et les types de nœuds live.
import json
import re
import sys
import zipfile

HELP_ZIP, LIVE_JSON, OUT_MD = sys.argv[1], sys.argv[2], sys.argv[3]
D = "11 October 2026"
MAX_DESC_WORDS = 26

z = zipfile.ZipFile(HELP_ZIP)
live = json.load(open(LIVE_JSON))


def clean(t):
    t = re.sub(r"__([^_]+)__", r"\1", t)
    t = re.sub(r"\[Node:([^\]|]+)\|?[^\]]*\]", lambda m: m.group(1).split("/")[-1], t)
    t = re.sub(r"\[([^\]|]+)\|[^\]]*\]", r"\1", t)
    t = re.sub(r"\[([^\]]+)\]", r"\1", t)
    t = t.replace("((", "").replace("))", "").replace("`", "")
    t = t.replace("—", ", ").replace("–", ", ").replace("--", ", ")
    return " ".join(t.split())


def first_words(t, n=MAX_DESC_WORDS):
    t = clean(t)
    m = re.match(r"(.+?[.!?])(\s|$)", t)
    s = m.group(1) if m else t
    w = s.split()
    return " ".join(w[:n]) + (" ..." if len(w) > n else "")


def parse(text):
    head = dict(re.findall(r"^#(\w+):\s*(.+)$", text, re.M))
    title = re.search(r"^=\s*(.+?)\s*=\s*$", text, re.M)
    summ = re.search(r'"""(.+?)"""', text, re.S)
    body = text
    overview = ""
    ov = re.search(r'"""[\s\S]+?"""([\s\S]*?)(@parameters|@inputs|@outputs|@related|$)', text)
    if ov:
        paras = [clean(p) for p in re.split(r"\n\s*\n", ov.group(1)) if p.strip() and not p.strip().startswith("==")]
        paras = [p for p in paras if not p.startswith(":") and not p.startswith("#")]
        overview = " ".join(paras[:2])
        overview = " ".join(overview.split()[:60])
    sections = {}
    for name in ("parameters", "inputs", "outputs", "related"):
        m = re.search(r"^@" + name + r"\s*$([\s\S]*?)(?=^@\w+\s*$|\Z)", text, re.M)
        sections[name] = m.group(1) if m else ""
    return head, (title.group(1) if title else ""), (clean(summ.group(1)) if summ else ""), overview, sections


def parse_entries(block):
    """Entries are 'Label:' lines at indent 0 followed by indented #id and description."""
    entries = []
    folder = ""
    lines = block.split("\n")
    i = 0
    while i < len(lines):
        ln = lines[i]
        hm = re.match(r"^(={2,4})\s*(.+?)\s*\1\s*$", ln)
        if hm:
            folder = hm.group(2)
            i += 1
            continue
        lm = re.match(r"^(\S[^:#]*?):\s*$", ln)
        if lm:
            label = lm.group(1).strip()
            ids, desc, items = [], [], []
            i += 1
            while i < len(lines) and (lines[i].startswith(" ") or lines[i].strip() == ""):
                s = lines[i].strip()
                im = re.match(r"^#id:\s*(.+)$", s)
                if im:
                    ids = [x.strip() for x in im.group(1).split(",") if x.strip()]
                elif re.match(r"^\S[^:]{0,40}:\s*$", s) and lines[i].startswith("    ") and not lines[i].startswith("        "):
                    items.append(s[:-1].strip())
                elif s and not s.startswith("#") and not s.startswith(":") and not items:
                    desc.append(s)
                i += 1
            entries.append({"folder": folder, "label": label, "ids": ids, "desc": " ".join(desc), "items": items})
            continue
        i += 1
    return entries


def fmt_default(v):
    if isinstance(v, list):
        if len(v) == 1:
            v = v[0]
        else:
            return "(" + ", ".join(fmt_default(x) for x in v[:4]) + ")"
    if isinstance(v, float):
        return f"{v:g}"
    return str(v)[:40]


nodes = []
for n in sorted(z.namelist()):
    if not n.startswith("cop/") or not n.endswith(".txt"):
        continue
    internal = n[4:-4]
    if internal.startswith("_"):
        continue
    text = z.read(n).decode("utf-8", "replace")
    head, title, summ, overview, secs = parse(text)
    nodes.append((internal, head, title, summ, overview, secs))

out = []
out.append(f"## 3. COP node reference, Houdini 22.0.368 ({D})")
out.append("")
out.append(f"- Generated by `/Users/zenray/.claude/tmp/tmp-zenray-height/Scripts/BuildCopReference.py` from the local help archive `nodes.zip` (folder `cop/`) and from a live introspection of the node types of the open session (parameter names, types, defaults, menus). Descriptions are condensed to their first sentence; the full text stays in the local help ({D}).")
out.append(f"- Entry format: summary, overview, inputs, outputs, then parameters as `folder > Label (id, type, default) [menu]: first sentence` ({D}).")
out.append(f"- Nodes documented: {len(nodes)} help pages; live node types: {len(live)} ({D}).")
out.append("")
# alphabetical index line by line
out.append(f"### 3.0 Alphabetical index of COP nodes ({D})")
out.append("")
for internal, head, title, summ, overview, secs in nodes:
    out.append(f"- `{internal}` {title}: {summ} ({D})")
out.append("")
for internal, head, title, summ, overview, secs in nodes:
    lv = live.get(internal, {})
    lp = {p["name"]: p for p in lv.get("parms", [])}
    out.append(f"### {title} `cop/{internal}` ({D})")
    out.append("")
    flags = []
    if lv.get("deprecated"):
        flags.append("deprecated")
    if lv.get("hidden"):
        flags.append("hidden")
    out.append(f"- Summary: {summ}{' [' + ', '.join(flags) + ']' if flags else ''} ({D})")
    if overview:
        out.append(f"- Overview: {overview} ({D})")
    for key in ("inputs", "outputs"):
        ents = parse_entries(secs[key])
        if ents:
            txt = "; ".join(f"{e['label']}" + (f" ({first_words(e['desc'], 14)})" if e["desc"] else "") for e in ents)
            out.append(f"- {key.capitalize()}: {txt} ({D})")
    ents = parse_entries(secs["parameters"])
    seen = set()
    for e in ents:
        ids = e["ids"] or []
        meta = []
        for pid in ids[:1]:
            p = lp.get(pid)
            if p:
                seen.add(pid)
                meta.append(p.get("type", ""))
                if "default" in p:
                    meta.append("default " + fmt_default(p["default"]))
        idtxt = ", ".join(ids[:3]) + (" ..." if len(ids) > 3 else "")
        menu = ""
        if e["items"]:
            menu = " [" + " | ".join(e["items"][:12]) + (" ..." if len(e["items"]) > 12 else "") + "]"
        folder = (e["folder"] + " > ") if e["folder"] else ""
        desc = first_words(e["desc"]) if e["desc"] else ""
        out.append(f"- Parm {folder}{e['label']} ({idtxt}{'; ' + '; '.join(meta) if meta else ''}){menu}: {desc} ({D})")
    # live parameters missing from the help page
    extra = [p for name, p in lp.items() if name not in seen and p.get("type") not in ("Separator", "Label")]
    if extra:
        names = ", ".join(f"{p['name']} ({p.get('label','')})" for p in extra[:30])
        out.append(f"- Live parameters not described in the help: {names}{' ...' if len(extra) > 30 else ''} ({D})")
    rel = re.findall(r"Node:cop/(\w+)", secs["related"])
    if rel:
        out.append(f"- Related: {', '.join(sorted(set(rel)))} ({D})")
    out.append(f"- Source: local help nodes.zip, cop/{internal}.txt ({D})")
    out.append("")

open(OUT_MD, "w", encoding="utf-8").write("\n".join(out) + "\n")
print("nodes", len(nodes), "bytes", sum(len(x) + 1 for x in out))
