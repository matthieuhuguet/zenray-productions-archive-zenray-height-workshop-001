# 11 October 2026 : digest of the local Copernicus and Heightfield COP guides of Houdini 22.0.368 (headings, node chains, condensed sentences)
# FR : condensé des guides locaux Copernicus et HeightField COP (titres, nœuds cités, phrases condensées).
import glob
import os
import re
import sys

HELP = "/Applications/Houdini/Current/Frameworks/Houdini.framework/Versions/Current/Resources/houdini/help"
OUT = sys.argv[1]
D = "11 October 2026"


def clean(t):
    t = re.sub(r"__([^_]+)__", r"\1", t)
    t = re.sub(r"\[Node:/?cop/(\w+)\|?[^\]]*\]", r"cop/\1", t)
    t = re.sub(r"\[([^\]|]+)\|[^\]]*\]", r"\1", t)
    t = re.sub(r"\[([^\]]+)\]", r"\1", t)
    t = t.replace("((", "").replace("))", "").replace("`", "")
    t = t.replace("—", ", ").replace("–", ", ").replace("--", ", ")
    return " ".join(t.split())


def condense(t, n=28):
    t = clean(t)
    m = re.match(r"(.+?[.!?])(\s|$)", t)
    s = m.group(1) if m else t
    w = s.split()
    return " ".join(w[:n]) + (" ..." if len(w) > n else "")


out = [f"## 7. Local Copernicus and HeightField COP guides, Houdini 22.0.368 ({D})", "",
       f"- Generated by `/Users/zenray/.claude/tmp/tmp-zenray-height/Scripts/BuildGuideDigest.py` from `{HELP}/copernicus/*.txt` and `{HELP}/heightfields_cop/*.txt`; each paragraph is condensed to its first sentence, node mentions are listed per page ({D}).", ""]
for folder in ("copernicus", "heightfields_cop"):
    for path in sorted(glob.glob(os.path.join(HELP, folder, "*.txt"))):
        name = os.path.basename(path)[:-4]
        if name.startswith("_"):
            continue
        text = open(path, encoding="utf-8", errors="replace").read()
        title = re.search(r"^=\s*(.+?)\s*=\s*$", text, re.M)
        summ = re.search(r'"""(.+?)"""', text, re.S)
        nodes = sorted(set(re.findall(r"Node:/?cop/(\w+)", text)))
        out.append(f"### {title.group(1) if title else name} `{folder}/{name}` ({D})")
        out.append("")
        if summ:
            out.append(f"- Summary: {clean(summ.group(1))} ({D})")
        if nodes:
            out.append(f"- COP nodes cited: {', '.join(nodes)} ({D})")
        section = ""
        for block in re.split(r"\n\s*\n", text):
            b = block.strip()
            if not b:
                continue
            hm = re.match(r"^(={2,4})\s*(.+?)\s*\1", b)
            if hm:
                section = clean(hm.group(2))
                out.append(f"- Section: {section} ({D})")
                continue
            if b.startswith(("#", ":", "@", '"""', "=", "TIP", "NOTE", "WARNING")) or b.startswith("[Image") or "#display" in b:
                continue
            s = condense(b)
            if len(s.split()) >= 5:
                out.append(f"- {s} ({D})")
        out.append(f"- Source: local help {folder}/{name}.txt ({D})")
        out.append("")
open(OUT, "w", encoding="utf-8").write("\n".join(out) + "\n")
print("lines", len(out))
